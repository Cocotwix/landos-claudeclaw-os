{
  "name": "claudeclaw",
  "version": "1.1.0",
  "description": "Your personal Claude Code assistant, delivered to your phone via Telegram",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc",
    "build:web": "vite build",
    "build:server": "tsc",
    "start": "node scripts/start.mjs",
    "landos:status": "node scripts/runtime/landos-runtime.mjs status",
    "landos:start": "node scripts/runtime/landos-runtime.mjs start",
    "landos:stop": "node scripts/runtime/landos-runtime.mjs stop",
    "landos:restart": "node scripts/runtime/landos-runtime.mjs restart",
    "landos:logs": "node scripts/runtime/landos-runtime.mjs logs",
    "landos:health": "node scripts/runtime/landos-runtime.mjs health",
    "landos:hermes:profile": "node scripts/hermes/provision-landos-profile.mjs",
    "landos:hermes:profile:check": "node scripts/hermes/provision-landos-profile.mjs --check",
    "landos:hermes:analyst": "node scripts/hermes/provision-acquisition-analyst.mjs",
    "landos:hermes:analyst:check": "node scripts/hermes/provision-acquisition-analyst.mjs --check",
    "landos:hermes:specialists": "node scripts/hermes/provision-specialist-profiles.mjs",
    "landos:hermes:specialists:check": "node scripts/hermes/provision-specialist-profiles.mjs --check",
    "landos:hermes:specialist:invoke": "node scripts/hermes/specialist-bot-invoke.mjs",
    "landos:intelligence:executor": "node scripts/landos/intelligence-executor.mjs",
    "hermes:governed:audit": "node scripts/hermes/governed-profile-manager.mjs audit",
    "hermes:governed:provision": "node scripts/hermes/governed-profile-manager.mjs provision --apply-external",
    "hermes:governed:check": "node scripts/hermes/governed-profile-manager.mjs check",
    "test:hermes:governed": "node --test scripts/hermes/governed-profile-manager.test.mjs",
    "landos:pair": "node scripts/runtime/landos-runtime.mjs pair",
    "landos:visual-ready": "node scripts/runtime/landos-runtime.mjs visual-ready",
    "landos:acceptance:unit": "node --test scripts/acceptance/*.test.mjs",
    "landos:acceptance:run": "playwright test scripts/acceptance/specs/landos-704-bell.visual.spec.ts --config=playwright.config.ts",
    "landos:acceptance:report": "node scripts/acceptance/generate-report.mjs",
    "landos:acceptance:gate": "node scripts/acceptance/completion-gate.mjs",
    "landos:mcp:test": "python -B mcp/landos/run_checks.py test",
    "landos:mcp:inspect": "python -B mcp/landos/run_checks.py inspect",
    "landos:mcp:schemas": "vitest run src/landos/governance/hermes-worker-schema.test.ts src/landos/governance/mcp-bridge.test.ts",
    "landos:runtime:test": "node --test scripts/runtime/landos-runtime.test.mjs scripts/runtime/landos-visual-recovery.test.mjs",
    "landos:hive": "tsx src/hive-cli.ts",
    "landos:mission": "tsx src/mission-cli.ts",
    "landos:memory:status": "node scripts/memory/landos-memory.mjs status",
    "landos:memory:audit": "node scripts/memory/landos-memory.mjs audit",
    "landos:memory:checkpoint": "node scripts/memory/landos-memory.mjs checkpoint",
    "landos:memory:validate": "node scripts/memory/landos-memory.mjs validate",
    "landos:memory:retrieve": "node scripts/memory/landos-memory.mjs retrieve",
    "landos:knowledge:check": "node scripts/knowledge/validate-landos-knowledge.mjs",
    "landos:knowledge:test": "node --test scripts/knowledge/validate-landos-knowledge.test.mjs",
    "landos:knowledge:query": "node scripts/knowledge/query-landos-knowledge.mjs",
    "landos:sprint": "tsx scripts/sprint/landos-sprint-cli.ts",
    "landos:task": "node scripts/dev/task.mjs",
    "landos:task:test": "node --test scripts/dev/task.test.mjs scripts/dev/verify.test.mjs scripts/dev/env-guard.test.mjs",
    "landos:control": "node scripts/control/landos-control.mjs",
    "landos:control:test": "node --test scripts/control/*.test.mjs",
    "landos:build": "node scripts/devloop/build.mjs",
    "landos:build:watch": "node scripts/devloop/build.mjs watch",
    "landos:build:test": "node --test scripts/devloop/build.test.mjs",
    "landos:data:backup": "node scripts/data/landos-business-backup.mjs backup",
    "landos:data:restore": "node scripts/data/landos-business-backup.mjs restore",
    "landos:data:drill": "node scripts/data/landos-business-backup.mjs drill",
    "landos:data:db-drill": "node scripts/data/landos-data.mjs drill",
    "landos:qa:init": "tsx scripts/data/init-landos-qa.ts",
    "landos:operator-qa": "tsx scripts/sprint/landos-operator-qa-cli.ts",
    "landos:phase1:simulate": "tsx scripts/simulation/landos-phase1-five-lead.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "agent:create": "bash scripts/agent-create.sh",
    "agent:start": "node dist/index.js --agent",
    "uninstall": "bash scripts/uninstall.sh",
    "build:warroom-client": "esbuild warroom/client.js --bundle --outfile=warroom/client.bundle.js --format=iife --global-name=PipecatWarRoom",
    "landos:browser": "tsx src/landos/automation-browser-cli.ts",
    "landos:browser:qa": "tsx scripts/qa/landos-browser-qa-cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.191",
    "@google/genai": "^1.44.0",
    "@hono/node-server": "^1.19.9",
    "@monaco-editor/react": "^4.7.0",
    "@slack/web-api": "^7.14.1",
    "@types/pdfkit": "^0.17.6",
    "@types/three": "^0.184.0",
    "@zed-industries/codex-acp": "^0.14.0",
    "apify-client": "^2.23.4",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "grammy": "^1.34.0",
    "hono": "^4.12.29",
    "js-yaml": "^4.3.0",
    "monaco-editor": "^0.55.1",
    "openai": "^6.45.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "three": "^0.184.0",
    "whatsapp-web.js": "^1.34.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pipecat-ai/client-js": "^1.7.0",
    "@pipecat-ai/websocket-transport": "^1.6.2",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3-geo": "^3.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^2.0.0",
    "d3-geo": "^3.1.1",
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.0",
    "lucide-preact": "^1.14.0",
    "marked": "^18.0.2",
    "preact": "^10.29.1",
    "tailwindcss": "^4.2.4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0",
    "wouter-preact": "^3.9.0"
  },
  "_comment_overrides": "Transitive-only security pins. Each entry exists because npm audit flags the version our dependency graph would otherwise resolve, and no parent publishes a fixed release yet. axios is deliberately absent: 1.18.0 is already clean, so an override there would be dead config. dompurify is deliberately absent: the direct devDependency is bumped instead, because an override would also force monaco-editor's pinned nested copy and npm reports that fix as a monaco major.",
  "overrides": {
    "ws": "^8.21.0",
    "protobufjs": "^7.6.5",
    "@protobufjs/utf8": "^1.1.2",
    "basic-ftp": "^5.3.1",
    "form-data": "^4.0.6"
  },
  "engines": {
    "node": ">=20"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "src/**/*.test.ts"
    ]
  }
}
