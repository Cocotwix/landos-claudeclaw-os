# Dependencies
node_modules/

# Build output
dist/

# Environment — never commit API keys
.env

# Every other .env variant is ignored too, then the documented templates are
# added back explicitly. Ignoring `.env` alone left the far more dangerous
# files exposed: a credential-rotation script writes a FULL COPY of .env to
# `.env.bak-rotate`, and `.env.local` / `.env.production` are equally live.
# None of those were matched, so a single `git add .` would have staged them.
# Deny-then-allow rather than enumerating backup suffixes: a suffix nobody
# predicted is the one that leaks.
.env*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Credential-rotation and generic backup copies, wherever they land. Bare
# patterns so they match in any directory, not just the repo root.
*.bak
*.bak-rotate
*.bak.rotate
*.backup

# Deployment configuration filled in with live secrets (the counterpart of a
# committed *.example). Bare pattern for the same reason as above.
claudeclaw-deploy.conf
landos-deploy.conf

# Runtime data — NEVER commit. Contains WhatsApp/Slack messages,
# session tokens, conversation logs, and database files.
store/
workspace/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Pre-migration backups produced by scripts/migrate.ts. Belt-and-suspenders
# even though store/ above already covers the canonical location.
*.db.pre-*.bak
*.db.pre-*.bak-wal

# Migration state — local only
migrations/.applied.json

# Logs
*.log
/tmp/claudeclaw.*
/.runtime/

# Python
__pycache__/
*.pyc
.venv/
warroom/.venv/

# Generated outputs — personal diagrams, not for sharing
outputs/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
.wwebjs_cache/

# Personal scripts — not for sharing
scripts/waste-reminder.sh
start-main.sh
start-main.bat
WARROOM_TEST_PLAN.md

# ── Working docs / planning artifacts ─────────────────────────────────
# Anything matching here is personal scratch work that must never reach
# the public repo. Names are intentionally broad so a future accidentally-
# named planning doc gets caught before it can be committed. README.md,
# CLAUDE.md, CHANGELOG.md, CONTRIBUTING.md and the docs/ files explicitly
# referenced from the README are NOT matched by these patterns.
/PLAN*.md
/SHIP*.md
/TESTING*.md
/AUDIT*.md
/REPORT*.md
/CHECKLIST*.md
/REDTEAM*.md
/SMOKE*.md
/SCRATCH*.md
/NOTES*.md
/test_plan.md
/update_plan.md
/execute_plan_prompt.md
/*_tldr.md
/*_TLDR.md
/PR[0-9]*_NOTES*.md
/PR[0-9]*_TESTING*.md
/docs/*-results.md
/docs/*-smoke.md
/docs/redteam-*.md
/docs/scratch-*.md
/docs/internal/

# Diagram generation manifests are scratch input for scripts/generate-diagrams.py
# Only scripts/diagrams-batch.json is the canonical, tracked manifest.
/scripts/diagrams-test.json
/scripts/diagrams-retry.json
/scripts/diagrams-fix.json
/scripts/diagrams-scratch*.json

# Generated Windows service wrappers (contain hardcoded paths).
# Note: launchd/ plists are committed with __PROJECT_DIR__ / __HOME__
# placeholders, so they stay tracked.
win/

# War Room dev/test artifacts
warroom/test-audio*.wav
warroom/test_harness.py
warroom/TEST_REPORT.md
warroom/music.mp3
warroom/avatars/backup-*/
warroom/avatars/photoreal-backup/

# Personal config — lives in CLAUDECLAW_CONFIG (default ~/.claudeclaw)
CLAUDE.md
agents/*/agent.yaml
agents/*/CLAUDE.md
agents/*/avatar.png
agents/*/.no-avatar
agents/*/CLAUDE.md.backup
agents/*/agent.yaml.backup

# Repo-backed LandOS agents — these ARE version-controlled (override the CLAUDE.md rule above)
!landos-agents/*/CLAUDE.md
!landos-agents/*/agent.yaml

# Local Claude Code skills — these are user-specific workflow configs
# (absolute paths, private repo refs). Keep them out of the shared repo.
.claude/skills/

# Kilo agent tool config — per-machine tool permissions and local rule files,
# not project source. Scoped to the directory itself so a future top-level
# file merely starting with "kilo" is still tracked normally.
.kilo/

# Claudex (codex review loop) state and logs. Per-machine artifacts:
# state files reference local PIDs and absolute paths; log files stream
# every reviewer invocation. Both at the project root AND inside per-agent
# CWDs (sub-agents start with cwd=agents/<id>).
.claude/claudex/
agents/*/.claude/claudex/

# ── LandOS local QA scratch — property-specific probe output, never share ──
# Root-level API/report dumps captured during card-level QA (contain real
# property addresses and local absolute paths).
/rep*.json
/report*.json
/reportrun*.json
/vi14*.json
# Browser-QA screenshot dumps of real deal cards.
/docs/landos/qa-*/
# One-off card/property-specific probe and repair scripts. Canonical LandOS
# tooling lives in scripts/runtime/, scripts/sprint/, scripts/memory/.
/scripts/qa-inspect-*.mjs
/scripts/repair-card*.mjs
/scripts/recover-tennessee-mismatch.ts
/scripts/check-public-intelligence-persistence.ts
/scripts/inspect-card-counts.ts
/scripts/inspect-live-final.ts
/scripts/verify-final-acceptance.ts
/scripts/verify-post-review-live.ts
/scripts/verify-public-intelligence.ts
/scripts/verify-tennessee-resolution.ts
/src/landos/sandbox-probe.ts

# ── QA / build scratch artifacts — never share ───────────────────────
# Throwaway probe/verify/recon/screenshot scripts use an underscore prefix
# by convention. All canonical scripts have clean names, so this is safe.
scripts/_*
# Acquisition + QA screenshot dumps
.acq-shots/
# Captured Chrome user-data profiles from browser automation. These are
# NOT reference UI — they contain Login Data, Web Data, cookies, and other
# session state that must never reach the repo.
_chrome/
docs/reference-ui/**/_chrome/
# Avatar marker for repo-backed LandOS agents (mirrors agents/*/.no-avatar)
landos-agents/*/.no-avatar
# Local-only vendor reference specs — kept on disk, not tracked yet
docs/external/
# Local-only install/update walkthrough transcript — personal, not for repo
landos-agents/ClaudeClaw_Mark_Install_and_Update_Workflow_Fork_Upstream_Git_Pull.txt

# LandOS — deal data, training material, and media files
# Root-anchored: a bare `data/` also matched `scripts/data/`, silently excluding
# the four backup/restore/drill/QA-init scripts that landos:data:* and
# landos:qa:init invoke, so a fresh checkout could not run them.
/data/
transcripts/
training/
deals/
notes/
*.csv
*.xlsx
*.pdf
*.mp3
*.wav
*.ogg

# ── LandOS acceptance run artifacts ──────────────────────────────────
# Written by createAcceptanceRunDirectory() in scripts/acceptance/runtime-
# helpers.mjs and filled by the Playwright visual spec. Fully reproducible
# with `npm run landos:acceptance:run`, and a single run is ~20 MB of
# trace.zip + video.webm, so these must never enter the pack. The directory
# itself is kept via its .gitkeep.
/.landos/acceptance/*
!/.landos/acceptance/.gitkeep

# Devloop candidate-lesson review queue — accumulated local state written by
# recordCandidateLesson() in scripts/devloop/lessons.mjs. Local queue awaiting
# hand-promotion into canonical governance, not source.
/.landos/devloop/

# Ad-hoc Chrome DevTools Protocol target dumps taken against the dedicated
# LandOS browser on CDP 9224. They carry live tab URLs for real deals.
/cdp_*.json

# Stray shell-redirect captures written to the repo root: scraped ordinance
# text, and a geocoder response whose filename became the property address.
/ww_zoning.txt
/1454 Onionville Rd, Sterling, NY 13156
